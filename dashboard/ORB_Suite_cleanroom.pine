// ORB Suite (clean-room): opening-range breakout indicator written from the
// public description of an ORB tool, not from its (closed) source.
// Builds the opening range for a custom session, locks it, and fires
// close-break or break + retest entries that pass the VWAP / EMA / RVOL /
// OR-width filters. Manages each trade with a stop, three targets, optional
// breakeven, opposite-break, time and end-of-session exits, and an optional
// one-shot stop-and-reverse. Colors candles by a weighted conviction score.
// Draws each trade's levels with event labels, prior-day and prior-OR levels,
// VWAP, a dashboard and a 5/15/30/60-minute OR ladder.
// Use a chart timeframe at or below the OR length. Set alerts to
// "Once per bar close": signals are evaluated on the bar's close.
//@version=6
indicator("ORB Suite (clean-room)", shorttitle = "ORB Suite", overlay = true, max_labels_count = 500, max_lines_count = 500, max_boxes_count = 500)

// ── Inputs ─────────────────────────────────────────────────────────────
// Every input uses display.none so the settings stay out of the status line.
grpOR = "Opening range"
sessIn  = input.session("0930-1600", "Session", group = grpOR, display = display.none)
tzIn    = input.string("America/New_York", "Timezone", group = grpOR, display = display.none)
orMin   = input.int(15, "OR length (min)", options = [5, 15, 30, 60], group = grpOR, display = display.none)
showMid = input.bool(true, "Show OR midpoint", group = grpOR, display = display.none)

grpEn = "Entries"
entryMode = input.string("Close break", "Entry mode", options = ["Close break", "Break + retest"], group = grpEn, display = display.none)
bufTicks  = input.int(0, "Break buffer (ticks)", minval = 0, group = grpEn, display = display.none)
dirMode   = input.string("Both", "Direction", options = ["Both", "Long only", "Short only"], group = grpEn, display = display.none)

grpF = "Filters"
useVwap  = input.bool(true, "Close on the VWAP side of the trade", group = grpF, display = display.none)
useEma   = input.bool(false, "Close on the EMA side, length", inline = "ema", group = grpF, display = display.none)
emaLen   = input.int(50, "", minval = 1, inline = "ema", group = grpF, display = display.none)
useRvol  = input.bool(false, "RVOL at least", inline = "rv", group = grpF, display = display.none)
rvolMin  = input.float(1.5, "", step = 0.1, inline = "rv", group = grpF, display = display.none)
rvolLen  = input.int(20, "RVOL length", minval = 1, group = grpF, display = display.none)
useWidth = input.bool(false, "OR width / daily ATR between", inline = "w", group = grpF, display = display.none)
widthMin = input.float(0.10, "", step = 0.05, inline = "w", group = grpF, display = display.none)
widthMax = input.float(0.60, "", step = 0.05, inline = "w", group = grpF, display = display.none)
dAtrLen  = input.int(14, "Daily ATR length", minval = 1, group = grpF, display = display.none)

grpR = "Stops & targets"
stopMode = input.string("Opposite OR side", "Stop", options = ["Opposite OR side", "OR midpoint", "ATR multiple", "% of OR"], group = grpR, display = display.none)
stopAtrM = input.float(1.0, "ATR multiple", step = 0.1, group = grpR, display = display.none)
atrLen   = input.int(14, "Chart ATR length", minval = 1, group = grpR, display = display.none)
stopPct  = input.float(50, "% of OR", step = 5, group = grpR, display = display.none)
tpMode   = input.string("R multiples", "Targets", options = ["R multiples", "OR extensions"], group = grpR, display = display.none)
tp1In    = input.float(1.0, "TP1", step = 0.25, inline = "tp", group = grpR, display = display.none)
tp2In    = input.float(2.0, "TP2", step = 0.25, inline = "tp", group = grpR, display = display.none)
tp3In    = input.float(3.0, "TP3", step = 0.25, inline = "tp", group = grpR, display = display.none)
minRR    = input.float(1.5, "Min R:R to TP2", step = 0.1, group = grpR, display = display.none)

grpX = "Exits"
beAfterTp1  = input.bool(true, "Move stop to breakeven after TP1", group = grpX, display = display.none)
exitTp3     = input.bool(true, "Exit at TP3", group = grpX, display = display.none)
exitOpp     = input.bool(true, "Exit on an opposite OR break", group = grpX, display = display.none)
useTimeExit = input.bool(false, "Time exit (also stops new entries) at", inline = "te", group = grpX, display = display.none)
teH         = input.int(11, "", minval = 0, maxval = 23, inline = "te", group = grpX, display = display.none)
teM         = input.int(30, ":", minval = 0, maxval = 59, inline = "te", group = grpX, display = display.none)
eodClose    = input.bool(true, "Close at session end", group = grpX, display = display.none)
useSar      = input.bool(false, "Stop-and-reverse (risk capped at the original 1R)", group = grpX, display = display.none)

grpD = "Daily limits"
maxTrades  = input.int(2, "Max trades per day", minval = 1, group = grpD, display = display.none)
useLossCap = input.bool(true, "Daily loss cap (R)", inline = "dl", group = grpD, display = display.none)
lossCapR   = input.float(2.0, "", step = 0.5, inline = "dl", group = grpD, display = display.none)

grpC = "Candles"
candleMode = input.string("Conviction", "Candle colors", options = ["Off", "Conviction", "OR side"], group = grpC, display = display.none)
wEma   = input.float(1.0, "Weight: EMA side", minval = 0, step = 0.5, group = grpC, display = display.none)
wVwap  = input.float(1.0, "Weight: VWAP side", minval = 0, step = 0.5, group = grpC, display = display.none)
wRsi   = input.float(1.0, "Weight: RSI vs 50", minval = 0, step = 0.5, inline = "rsi", group = grpC, display = display.none)
rsiLen = input.int(14, "len", minval = 1, inline = "rsi", group = grpC, display = display.none)
wMacd  = input.float(1.0, "Weight: MACD histogram", minval = 0, step = 0.5, group = grpC, display = display.none)
wRvol  = input.float(1.0, "Weight: RVOL candle", minval = 0, step = 0.5, group = grpC, display = display.none)
wOr    = input.float(1.5, "Weight: position vs OR", minval = 0, step = 0.5, group = grpC, display = display.none)
wMom   = input.float(1.0, "Weight: momentum", minval = 0, step = 0.5, inline = "mom", group = grpC, display = display.none)
momLen = input.int(10, "bars", minval = 1, inline = "mom", group = grpC, display = display.none)

grpV = "Display"
showLevels = input.bool(true, "Show trade levels", group = grpV, display = display.none)
showDash   = input.bool(true, "Show dashboard", group = grpV, display = display.none)
dashPosIn  = input.string("Top right", "Dashboard position", options = ["Top right", "Top left", "Bottom right", "Bottom left"], group = grpV, display = display.none)
showEvents = input.bool(true, "Event labels (ORB, TP1 ✓, SL ×, exits)", group = grpV, display = display.none)
shadeRR    = input.bool(true, "Shade each trade's risk and reward", group = grpV, display = display.none)
showVwap   = input.bool(true, "Show VWAP", group = grpV, display = display.none)
showPrior  = input.bool(true, "Prior-day (PDH/PDL/PDC) and prior-OR levels", group = grpV, display = display.none)
showEdge   = input.bool(true, "Label levels at the right edge", group = grpV, display = display.none)
showLadder = input.bool(true, "Show OR ladder (5 / 15 / 30 / 60m)", group = grpV, display = display.none)
ladPosIn   = input.string("Bottom right", "OR ladder position", options = ["Top right", "Top left", "Bottom right", "Bottom left"], group = grpV, display = display.none)

// ── Series ─────────────────────────────────────────────────────────────
buf   = bufTicks * syminfo.mintick
vwapV = ta.vwap(hlc3)
emaV  = ta.ema(close, emaLen)
atrV  = ta.atr(atrLen)
rvol  = volume / ta.sma(volume, rvolLen)
rsiV  = ta.rsi(close, rsiLen)
[_, _, macdH] = ta.macd(close, 12, 26, 9)
// Prior completed day's ATR, so it does not change during the session.
dAtr = request.security(syminfo.tickerid, "D", ta.atr(dAtrLen)[1], lookahead = barmerge.lookahead_on)
[pdh, pdl, pdc] = request.security(syminfo.tickerid, "D", [high[1], low[1], close[1]], lookahead = barmerge.lookahead_on)

inSess  = not na(time(timeframe.period, sessIn, tzIn))
// A new calendar day also starts a session, so RTH-only charts (no bars
// between sessions) still reset the OR every day.
dayKey  = year(time, tzIn) * 10000 + month(time, tzIn) * 100 + dayofmonth(time, tzIn)
newSess = inSess and (not inSess[1] or dayKey != dayKey[1])

hhmmToMin(s) => int(str.tonumber(str.substring(s, 0, 2))) * 60 + int(str.tonumber(str.substring(s, 2, 4)))
sessEndMin = hhmmToMin(str.substring(sessIn, 5, 9))
closeMin   = hour(time_close, tzIn) * 60 + minute(time_close, tzIn)
eodBar     = inSess and closeMin >= sessEndMin
pastCutoff = inSess and useTimeExit and closeMin >= teH * 60 + teM

tfBad = not timeframe.isintraday or timeframe.in_seconds() > orMin * 60

// ── Trade state ────────────────────────────────────────────────────────
type Trade
    int   dir
    float entry
    float stop
    float risk0
    float tp1
    float tp2
    float tp3
    bool  tp1Hit = false
    bool  tp2Hit = false
    bool  rev    = false
    int   bar

// Stop and targets for a trade in `dir` from `entry`. A non-na `cap` limits
// the risk to that distance (used by stop-and-reverse).
planTrade(int dir, float entry, float hi, float lo, float cap) =>
    rng  = hi - lo
    stop = switch stopMode
        "Opposite OR side" => dir == 1 ? lo : hi
        "OR midpoint"      => (hi + lo) / 2
        "ATR multiple"     => entry - dir * stopAtrM * atrV
        =>                    entry - dir * stopPct / 100 * rng
    risk = dir * (entry - stop)
    if not na(cap) and (risk > cap or risk <= 0)
        risk := cap
        stop := entry - dir * cap
    base = dir == 1 ? hi : lo
    t1 = tpMode == "R multiples" ? entry + dir * tp1In * risk : base + dir * tp1In * rng
    t2 = tpMode == "R multiples" ? entry + dir * tp2In * risk : base + dir * tp2In * rng
    t3 = tpMode == "R multiples" ? entry + dir * tp3In * risk : base + dir * tp3In * rng
    [stop, risk, t1, t2, t3]

var float orH = na
var float orL = na
var int   orState = 0          // 0 none, 1 building, 2 locked
var int   orEnd = na
var bool  longArmed = true
var bool  shortArmed = true
var bool  pendL = false
var bool  pendS = false
var int   tradesToday = 0
var float dayR = 0.0
var float lastR = na
var string lastWhy = ""
var Trade t = na
var Trade lastT = na           // the open trade, or the day's last one, for the dashboard
var float pORH = na            // previous session's opening range
var float pORL = na
var box   orBox = na

// Drawings of the open trade: lines [stop, entry, TP1, TP2, TP3] and boxes [risk, reward].
var array<line> lvLines = array.new<line>()
var array<box>  lvBoxes = array.new<box>()

evLabel(float y, string txt, color c, string pos) =>
    if showEvents
        st = pos == "above" ? label.style_label_down : pos == "below" ? label.style_label_up : label.style_none
        label.new(bar_index, y, txt, style = st, color = color.new(color.black, 100), textcolor = c, size = size.small)

drawLevels(Trade tr) =>
    array.clear(lvLines)
    array.clear(lvBoxes)
    if showLevels
        x = bar_index
        array.push(lvLines, line.new(x, tr.stop, x + 1, tr.stop, color = color.red, width = 2))
        array.push(lvLines, line.new(x, tr.entry, x + 1, tr.entry, color = color.new(color.blue, 0)))
        array.push(lvLines, line.new(x, tr.tp1, x + 1, tr.tp1, color = color.new(color.green, 40), style = line.style_dashed))
        array.push(lvLines, line.new(x, tr.tp2, x + 1, tr.tp2, color = color.new(color.green, 20), style = line.style_dashed))
        array.push(lvLines, line.new(x, tr.tp3, x + 1, tr.tp3, color = color.new(color.green, 0), style = line.style_dashed))
        if shadeRR
            array.push(lvBoxes, box.new(x, math.max(tr.entry, tr.stop), x + 1, math.min(tr.entry, tr.stop), border_color = color.new(color.red, 100), bgcolor = color.new(color.red, 88)))
            array.push(lvBoxes, box.new(x, math.max(tr.entry, tr.tp2), x + 1, math.min(tr.entry, tr.tp2), border_color = color.new(color.green, 100), bgcolor = color.new(color.green, 90)))

extendLevels() =>
    for ln in lvLines
        line.set_x2(ln, bar_index)
    for bx in lvBoxes
        box.set_right(bx, bar_index)

// End the stop line here and continue it at the new price (breakeven).
moveStopLine(float px) =>
    if array.size(lvLines) > 0
        line.set_x2(array.get(lvLines, 0), bar_index)
        array.set(lvLines, 0, line.new(bar_index, px, bar_index, px, color = color.orange, width = 2, style = line.style_dotted))

lockEvt = false
pendEvtL = false
pendEvtS = false
longEvt = false
shortEvt = false
mutedL = false
mutedS = false
tp1Evt = false
tp2Evt = false
tp3Evt = false
stopEvt = false
revEvt = false
exitEvt = false

// A position left open from the previous session closes at this open.
if newSess and not na(t)
    lastR := t.dir * (open - t.entry) / t.risk0
    dayR += lastR
    lastWhy := "Carry-over"
    t := na
    exitEvt := true

if newSess
    pORH := orH
    pORL := orL

// ── Opening range: BUILDING -> LOCKED ──────────────────────────────────
if newSess
    orH := high
    orL := low
    orState := 1
    orEnd := time + orMin * 60000
    longArmed := true
    shortArmed := true
    pendL := false
    pendS := false
    tradesToday := 0
    dayR := 0.0
    lastR := na
    lastWhy := ""
    lastT := na
    orBox := box.new(bar_index, high, bar_index, low, border_color = color.new(color.yellow, 40), bgcolor = color.new(color.yellow, 88))
else if inSess and orState == 1
    orH := math.max(orH, high)
    orL := math.min(orL, low)

if inSess and orState == 1 and time_close >= orEnd
    orState := 2
    lockEvt := true

// The OR box spans the building window; ORH / ORL lines carry on for the day.
if inSess and not na(orBox) and (orState == 1 or lockEvt)
    box.set_top(orBox, orH)
    box.set_bottom(orBox, orL)
    box.set_right(orBox, bar_index)
    if lockEvt
        box.set_bgcolor(orBox, color.new(color.blue, 85))
        box.set_border_color(orBox, color.new(color.blue, 40))

orRng      = orH - orL
widthRatio = orRng / dAtr
widthOk    = not useWidth or (widthRatio >= widthMin and widthRatio <= widthMax)
active     = inSess and orState == 2 and not lockEvt
lossHit    = useLossCap and dayR <= -lossCapR

// ── Manage the open trade (from the bar after entry; stop before targets) ──
exitPx  = float(na)
exitWhy = ""
if active and not na(t) and bar_index > t.bar
    d = t.dir
    if d == 1 ? low <= t.stop : high >= t.stop
        exitPx  := t.stop
        exitWhy := t.tp1Hit and beAfterTp1 ? "Breakeven" : "Stop"
        stopEvt := true
    else
        if not t.tp1Hit and (d == 1 ? high >= t.tp1 : low <= t.tp1)
            t.tp1Hit := true
            tp1Evt := true
            evLabel(t.tp1, "TP1 ✓", color.green, "mid")
            if beAfterTp1
                t.stop := t.entry
                moveStopLine(t.entry)
        if not t.tp2Hit and (d == 1 ? high >= t.tp2 : low <= t.tp2)
            t.tp2Hit := true
            tp2Evt := true
            evLabel(t.tp2, "TP2 ✓", color.green, "mid")
        if d == 1 ? high >= t.tp3 : low <= t.tp3
            tp3Evt := true
            evLabel(t.tp3, "TP3 ✓", color.green, "mid")
            if exitTp3
                exitPx  := t.tp3
                exitWhy := "TP3"
        if na(exitPx) and exitOpp and (d == 1 ? close < orL - buf : close > orH + buf)
            exitPx  := close
            exitWhy := "Opposite break"
        if na(exitPx) and pastCutoff
            exitPx  := close
            exitWhy := "Time"
        if na(exitPx) and eodClose and eodBar
            exitPx  := close
            exitWhy := "Session end"

if not na(exitPx)
    extendLevels()
    exitTag = switch exitWhy
        "Stop"           => "SL ×"
        "Breakeven"      => "BE"
        "Opposite break" => "OPP exit"
        "Time"           => "TIME exit"
        "Session end"    => "EOD exit"
        => ""
    if exitTag != ""
        evLabel(exitPx, exitTag, exitWhy == "Stop" ? color.red : color.gray, "mid")
    lastR := t.dir * (exitPx - t.entry) / t.risk0
    dayR += lastR
    lastWhy := exitWhy
    revDir   = -t.dir
    revEntry = t.stop
    revCap   = t.risk0
    wasStop  = exitWhy == "Stop" and not t.rev
    t := na
    exitEvt := not stopEvt
    lossHit := useLossCap and dayR <= -lossCapR
    // Stop-and-reverse: the opposite side opens at the stop price. It counts
    // toward max trades, skips the entry filters, and never reverses again.
    if useSar and wasStop and tradesToday < maxTrades and not lossHit
        [rs, rk, r1, r2, r3] = planTrade(revDir, revEntry, orH, orL, revCap)
        if rk > 0 and revDir * (r2 - revEntry) / rk >= minRR
            t := Trade.new(revDir, revEntry, rs, rk, r1, r2, r3, false, false, true, bar_index)
            lastT := t
            tradesToday += 1
            revEvt := true
            drawLevels(t)
            evLabel(revDir == 1 ? low : high, revDir == 1 ? "REV ▲" : "REV ▼", color.orange, revDir == 1 ? "below" : "above")
            if revDir == 1
                longArmed := false
            else
                shortArmed := false

// ── Entries ────────────────────────────────────────────────────────────
allowLong  = dirMode != "Short only"
allowShort = dirMode != "Long only"
canEnter   = tradesToday < maxTrades and not lossHit and not pastCutoff and not eodBar
longFilt   = (not useVwap or close > vwapV) and (not useEma or close > emaV) and (not useRvol or rvol >= rvolMin) and widthOk
shortFilt  = (not useVwap or close < vwapV) and (not useEma or close < emaV) and (not useRvol or rvol >= rvolMin) and widthOk

longTrig  = false
shortTrig = false
if active and na(t)
    // A side re-arms only after a close back inside the OR.
    if close <= orH and close >= orL
        longArmed := true
        shortArmed := true
        pendL := false
        pendS := false
    if allowLong
        if longArmed and close > orH + buf
            longArmed := false
            if entryMode == "Close break"
                longTrig := true
            else
                pendL := true
                pendEvtL := true
        else if pendL and low <= orH + buf and close > orH
            pendL := false
            longTrig := true
    if allowShort
        if shortArmed and close < orL - buf
            shortArmed := false
            if entryMode == "Close break"
                shortTrig := true
            else
                pendS := true
                pendEvtS := true
        else if pendS and high >= orL - buf and close < orL
            pendS := false
            shortTrig := true

if (longTrig or shortTrig) and canEnter
    dir = longTrig ? 1 : -1
    if dir == 1 ? longFilt : shortFilt
        [s, rk, a, b, c] = planTrade(dir, close, orH, orL, na)
        if rk > 0 and dir * (b - close) / rk >= minRR
            t := Trade.new(dir, close, s, rk, a, b, c, false, false, false, bar_index)
            lastT := t
            tradesToday += 1
            longEvt := dir == 1
            shortEvt := dir == -1
            drawLevels(t)
            evLabel(dir == 1 ? low : high, dir == 1 ? "ORB ▲" : "ORB ▼", dir == 1 ? color.green : color.red, dir == 1 ? "below" : "above")

if not na(t)
    extendLevels()
        else
            mutedL := dir == 1
            mutedS := dir == -1

// ── Conviction score (seven tiers) ─────────────────────────────────────
sEma  = close > emaV ? 1 : close < emaV ? -1 : 0
sVwap = close > vwapV ? 1 : close < vwapV ? -1 : 0
sRsi  = rsiV > 50 ? 1 : rsiV < 50 ? -1 : 0
sMacd = macdH > 0 ? 1 : macdH < 0 ? -1 : 0
sRvol = rvol >= rvolMin ? (close > open ? 1 : close < open ? -1 : 0) : 0
sOr   = inSess and orState == 2 ? (close > orH ? 1 : close < orL ? -1 : 0) : 0
sMom  = close > close[momLen] ? 1 : close < close[momLen] ? -1 : 0
wSum  = wEma + wVwap + wRsi + wMacd + wRvol + wOr + wMom
score = wSum > 0 ? (wEma * sEma + wVwap * sVwap + wRsi * sRsi + wMacd * sMacd + wRvol * sRvol + wOr * sOr + wMom * sMom) / wSum : 0.0
tier  = score >= 0.75 ? 3 : score >= 0.4 ? 2 : score >= 0.15 ? 1 : score > -0.15 ? 0 : score > -0.4 ? -1 : score > -0.75 ? -2 : -3

tierColor(int k) =>
    switch k
        3  => color.rgb(0, 200, 83)
        2  => color.rgb(76, 175, 80)
        1  => color.rgb(165, 214, 167)
        0  => color.rgb(158, 158, 158)
        -1 => color.rgb(239, 154, 154)
        -2 => color.rgb(239, 83, 80)
        => color.rgb(183, 28, 28)
tierName(int k) =>
    switch k
        3  => "Strong bull"
        2  => "Bull"
        1  => "Lean bull"
        0  => "Neutral"
        -1 => "Lean bear"
        -2 => "Bear"
        => "Strong bear"

orSideColor = not (inSess and orState == 2) ? na : close > orH ? color.rgb(0, 200, 83) : close < orL ? color.rgb(239, 83, 80) : color.rgb(158, 158, 158)
barcolor(candleMode == "Conviction" ? tierColor(tier) : candleMode == "OR side" ? orSideColor : na, title = "Candle colors")

// ── Plots ──────────────────────────────────────────────────────────────
showOr = inSess and orState > 0 and not newSess
plot(showOr ? orH : na, "ORH", color.new(color.teal, 0), 2, plot.style_linebr)
plot(showOr ? orL : na, "ORL", color.new(color.maroon, 0), 2, plot.style_linebr)
plot(showOr and showMid ? (orH + orL) / 2 : na, "OR mid", color.new(color.gray, 30), 1, plot.style_linebr)
plot(showVwap and inSess ? vwapV : na, "VWAP", color.new(color.fuchsia, 10), 1, plot.style_linebr)

showLv = showPrior and inSess and not newSess
plot(showLv ? pdh : na, "PDH", color.new(color.gray, 40), 1, plot.style_linebr)
plot(showLv ? pdl : na, "PDL", color.new(color.gray, 40), 1, plot.style_linebr)
plot(showLv ? pdc : na, "PDC", color.new(color.silver, 50), 1, plot.style_linebr)
plot(showLv ? pORH : na, "Prior ORH", color.new(color.teal, 70), 1, plot.style_linebr)
plot(showLv ? pORL : na, "Prior ORL", color.new(color.maroon, 70), 1, plot.style_linebr)

plotshape(mutedL, "Long below min R:R", shape.triangleup, location.belowbar, color.new(color.gray, 50), size = size.tiny)
plotshape(mutedS, "Short below min R:R", shape.triangledown, location.abovebar, color.new(color.gray, 50), size = size.tiny)
plotshape(pendEvtL, "Long break, awaiting retest", shape.diamond, location.belowbar, color.new(color.green, 40), size = size.tiny)
plotshape(pendEvtS, "Short break, awaiting retest", shape.diamond, location.abovebar, color.new(color.red, 40), size = size.tiny)
plot(score, "Conviction score", display = display.data_window)

// Right-edge labels; levels within a fifth of an ATR share one label ("PDC | ORH").
var array<label> edgeLbls = array.new<label>()
if barstate.islast
    for lb in edgeLbls
        label.delete(lb)
    array.clear(edgeLbls)
    if showEdge
        names = array.from("PDH", "PDL", "PDC", "pORH", "pORL", "ORH", "ORL", "VWAP")
        vals  = array.from(pdh, pdl, pdc, pORH, pORL, orH, orL, vwapV)
        keep  = array.from(showPrior, showPrior, showPrior, showPrior, showPrior, orState > 0, orState > 0, showVwap)
        tol   = nz(atrV, syminfo.mintick) * 0.2
        txts  = array.new<string>()
        pxs   = array.new<float>()
        for [i, v] in vals
            if na(v) or not array.get(keep, i)
                continue
            found = -1
            for [j, p] in pxs
                if math.abs(p - v) <= tol
                    found := j
                    break
            if found >= 0
                array.set(txts, found, array.get(txts, found) + " | " + array.get(names, i))
            else
                array.push(txts, array.get(names, i))
                array.push(pxs, v)
        for [k, p] in pxs
            array.push(edgeLbls, label.new(bar_index + 2, p, array.get(txts, k) + "  " + str.tostring(p, format.mintick), style = label.style_label_left, color = color.new(color.black, 100), textcolor = color.new(chart.fg_color, 20), size = size.small))

// ── OR ladder: the 5 / 15 / 30 / 60-minute ranges from chart bars ──────
var array<float> ladH = array.new<float>(4, na)
var array<float> ladL = array.new<float>(4, na)
var array<int>   ladS = array.new<int>(4, 0)    // 0 none, 1 building, 2 locked
var int sessStartT = na
ladLens = array.from(5, 15, 30, 60)
if newSess
    sessStartT := time
if inSess and not na(sessStartT)
    for [i, len] in ladLens
        endT = sessStartT + len * 60000
        if newSess
            array.set(ladH, i, high)
            array.set(ladL, i, low)
            array.set(ladS, i, 1)
        else if time < endT
            array.set(ladH, i, math.max(array.get(ladH, i), high))
            array.set(ladL, i, math.min(array.get(ladL, i), low))
        if array.get(ladS, i) == 1 and time_close >= endT
            array.set(ladS, i, 2)

// ── Tables ─────────────────────────────────────────────────────────────
posOf(string s) =>
    switch s
        "Top left"     => position.top_left
        "Bottom right" => position.bottom_right
        "Bottom left"  => position.bottom_left
        => position.top_right
var table dash = table.new(posOf(dashPosIn), 3, 11, bgcolor = color.new(chart.bg_color, 8), border_width = 1, border_color = color.new(chart.fg_color, 85))
var table lad  = table.new(posOf(ladPosIn), 5, 5, bgcolor = color.new(chart.bg_color, 8), border_width = 1, border_color = color.new(chart.fg_color, 85))

fmt(float v) => na(v) ? "—" : str.tostring(v, format.mintick)
fmtR(float r) => str.tostring(r, "+0.00;-0.00") + "R"
cellK(int r, string k) =>
    table.cell(dash, 1, r, k, text_color = chart.fg_color, text_size = size.small, text_halign = text.align_left)
cellV(int r, string v, color c) =>
    table.cell(dash, 2, r, v, text_color = c, text_size = size.small, text_halign = text.align_right)
// Tags the first row of a section and tints the rest (no cell merging, which
// would fail when the table is redrawn on the next realtime update).
section(int r0, int r1, string tag, color c) =>
    for r = r0 to r1
        table.cell(dash, 0, r, r == r0 ? tag : "", text_color = color.white, bgcolor = color.new(c, r == r0 ? 40 : 80), text_size = size.tiny)

if showDash and barstate.islast
    fg   = chart.fg_color
    up   = color.rgb(0, 200, 83)
    dn   = color.rgb(239, 83, 80)
    stateTxt = not inSess ? "CLOSED" : orState == 1 ? "BUILDING" : orState == 2 ? "LOCKED" : "—"
    stateCol = orState == 2 and inSess ? up : orState == 1 ? color.orange : color.gray
    table.cell(dash, 0, 0, "◆", text_color = fg, text_size = size.small)
    table.cell(dash, 1, 0, "OPENING RANGE", text_color = fg, text_size = size.normal, text_halign = text.align_left)
    table.cell(dash, 2, 0, stateTxt, text_color = color.black, bgcolor = stateCol, text_size = size.normal)

    widthCls = na(widthRatio) ? "—" : widthRatio < widthMin ? "NARROW" : widthRatio > widthMax ? "WIDE" : "NORMAL"
    section(1, 3, "OR", color.blue)
    cellK(1, "OR " + str.tostring(orMin) + "m · H / L")
    cellV(1, fmt(orH) + " / " + fmt(orL), color.aqua)
    cellK(2, "Width")
    cellV(2, widthCls + (na(widthRatio) ? "" : " · " + str.tostring(widthRatio, "0.00") + "×"), useWidth and not widthOk ? dn : up)
    cellK(3, "Filters")
    cellV(3, "VWAP " + (close > vwapV ? "▲" : "▼") + " · EMA " + (close > emaV ? "▲" : "▼") + " · RVOL " + str.tostring(rvol, "0.0") + "×", fg)

    statusTxt = orState == 1 ? "BUILDING OR" : "WAITING"
    statusCol = color.gray
    entTxt = "—"
    tpTxt  = "—"
    rrTxt  = "—"
    if not na(t)
        statusTxt := (t.dir == 1 ? "LONG" : "SHORT") + (t.tp1Hit ? " · TP1 ✓" : "") + " · " + fmtR(t.dir * (close - t.entry) / t.risk0)
        statusCol := t.dir == 1 ? up : dn
    else if not na(lastR)
        tag = switch lastWhy
            "Stop"           => "STOP"
            "Breakeven"      => "BE"
            "Opposite break" => "OPP"
            "Time"           => "TIME"
            "Session end"    => "EOD"
            => str.upper(lastWhy)
        statusTxt := tag + " " + fmtR(lastR)
        statusCol := lastR >= 0 ? up : dn
    else if tradesToday >= maxTrades or lossHit
        statusTxt := "DONE FOR DAY"
    if not na(lastT)
        entTxt := fmt(lastT.entry) + " · " + fmt(lastT.stop)
        tpTxt  := fmt(lastT.tp1) + " · " + fmt(lastT.tp2) + " · " + fmt(lastT.tp3)
        rrTxt  := "1 : " + str.tostring(lastT.dir * (lastT.tp2 - lastT.entry) / lastT.risk0, "0.0")
    section(4, 8, "TRADE", color.orange)
    cellK(4, "Status")
    cellV(4, statusTxt, statusCol)
    cellK(5, "Entry · Stop")
    cellV(5, entTxt, color.aqua)
    cellK(6, "TP1 · TP2 · TP3")
    cellV(6, tpTxt, up)
    cellK(7, "R:R to TP2")
    cellV(7, rrTxt, fg)
    cellK(8, "Today")
    cellV(8, str.tostring(tradesToday) + "/" + str.tostring(maxTrades) + " trades · " + fmtR(dayR) + (lossHit ? " · cap hit" : ""), dayR >= 0 ? fg : dn)

    section(9, 10, "READ", color.green)
    cellK(9, "Conviction")
    cellV(9, str.upper(tierName(tier)) + " " + str.tostring(score, "+0.00;-0.00"), tierColor(tier))
    cellK(10, "Timeframe")
    cellV(10, tfBad ? "Chart TF > OR length" : "OK", tfBad ? dn : fg)

if showLadder and barstate.islast
    fg = chart.fg_color
    hdr = array.from("OR", "High", "Low", "Mid", "State")
    for [c, h] in hdr
        table.cell(lad, c, 0, h, text_color = color.gray, text_size = size.small)
    for [i, len] in ladLens
        r = i + 1
        ok = timeframe.in_seconds() <= len * 60
        hi = array.get(ladH, i)
        lo = array.get(ladL, i)
        st = array.get(ladS, i)
        sel = len == orMin
        table.cell(lad, 0, r, str.tostring(len) + "m", text_color = sel ? color.black : fg, bgcolor = sel ? color.aqua : na, text_size = size.small)
        table.cell(lad, 1, r, ok ? fmt(hi) : "n/a", text_color = color.rgb(0, 200, 83), text_size = size.small)
        table.cell(lad, 2, r, ok ? fmt(lo) : "n/a", text_color = color.rgb(239, 83, 80), text_size = size.small)
        table.cell(lad, 3, r, ok ? fmt((hi + lo) / 2) : "n/a", text_color = fg, text_size = size.small)
        table.cell(lad, 4, r, not ok ? "TF too high" : st == 2 ? "LOCKED" : st == 1 ? "BUILDING" : "—", text_color = st == 2 ? color.rgb(0, 200, 83) : color.orange, text_size = size.small)

// ── Alerts ─────────────────────────────────────────────────────────────
alertcondition(lockEvt, "OR locked", "{{ticker}} opening range locked")
alertcondition(pendEvtL, "Long break, awaiting retest", "{{ticker}} closed above ORH, waiting for a retest")
alertcondition(pendEvtS, "Short break, awaiting retest", "{{ticker}} closed below ORL, waiting for a retest")
alertcondition(longEvt, "Long entry", "{{ticker}} ORB long entry at {{close}}")
alertcondition(shortEvt, "Short entry", "{{ticker}} ORB short entry at {{close}}")
alertcondition(tp1Evt, "TP1 hit", "{{ticker}} ORB TP1 hit")
alertcondition(tp2Evt, "TP2 hit", "{{ticker}} ORB TP2 hit")
alertcondition(tp3Evt, "TP3 hit", "{{ticker}} ORB TP3 hit")
alertcondition(stopEvt, "Stop hit", "{{ticker}} ORB stop hit")
alertcondition(revEvt, "Stop-and-reverse", "{{ticker}} ORB stop-and-reverse opened")
alertcondition(exitEvt, "Trade exit", "{{ticker}} ORB trade closed (TP3, opposite break, time or session end)")
