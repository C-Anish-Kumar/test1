# Copy to .env (./setup.sh does this and fills in the secrets).

# --- Required -------------------------------------------------------------
# Free key: https://finnhub.io/register  (baked into the image at build time;
# rebuild with `docker compose up -d --build` after changing it)
NEXT_PUBLIC_FINNHUB_API_KEY=
FINNHUB_BASE_URL=https://finnhub.io/api/v1

# Public URL people use to reach the app (no trailing slash).
# With the https profile this is https://<DOMAIN>.
BETTER_AUTH_URL=http://localhost:3000

# Generated by ./setup.sh
BETTER_AUTH_SECRET=
MONGO_ROOT_PASSWORD=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Hosting --------------------------------------------------------------
# Upstream OpenStock commit to build
OPENSTOCK_REF=18310116ec04862619fc5c746dd65947a09b29b6
# 127.0.0.1 keeps the app private to this machine; 0.0.0.0 exposes it on the LAN
OPENSTOCK_BIND=127.0.0.1
OPENSTOCK_PORT=3000
INNGEST_UI_PORT=8288
# For the optional Caddy HTTPS profile (DNS must point at this server)
# DOMAIN=stocks.example.com

# --- Optional -------------------------------------------------------------
# "realtime" refreshes quotes every 15s and enables email price alerts (rebuild needed)
NEXT_PUBLIC_OPENSTOCK_DATA_MODE=cached
# Extra Finnhub keys rotated per request, each adds 60 req/min
# FINNHUB_API_KEYS=key_one,key_two

# AI summaries in emails: gemini (default) | minimax | siray
# AI_PROVIDER=gemini
# GEMINI_API_KEY=
# MINIMAX_API_KEY=
# SIRAY_API_KEY=

# Email via Gmail (use an App Password). Without these, email features stay off.
# NODEMAILER_EMAIL=
# NODEMAILER_PASSWORD=

# Sentiment insights
# ADANOS_API_KEY=

# Social sign-in; any value turns the provider on, so leave commented until real.
# Callbacks: <BETTER_AUTH_URL>/api/auth/callback/google and /api/auth/callback/github
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
